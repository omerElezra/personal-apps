# Webhook Service Configuration
BEARER_TOKEN=your-secret-bearer-token-here

# These should be configured in Google Apps Script Properties
# USERNAME=your-stonkjournal-email@example.com
# PASSWORD=your-stonkjournal-password
# WEBHOOK_URL=https://your-webhook-service.com/ingest

### Build & Deploy 
gcloud run deploy gmail-csv-webhook \
  --project=stocks-report-474512 \
  --region=me-west1 \
  --source . \
  --allow-unauthenticated \
  --set-env-vars "BEARER_TOKEN=0b88af7a63873e27c0962e33a411bbdc09307b490b9c61bd45e16ad9a2f2c67c" \
  --cpu=1 --memory=1Gi --timeout=3600
  
### Deploy without build
  gcloud run deploy gmail-csv-webhook \
  --image=me-west1-docker.pkg.dev/stocks-report-474512/webhooks/gmail-csv-webhook:latest \
  --project=stocks-report-474512 \
  --region=me-west1 \
  --allow-unauthenticated \
  --set-env-vars "BEARER_TOKEN=0b88af7a63873e27c0962e33a411bbdc09307b490b9c61bd45e16ad9a2f2c67c" \
  --cpu=1 --memory=1Gi --timeout=3600